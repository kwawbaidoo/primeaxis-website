# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public address of the site, e.g. https://www.yourdomain.com
# Used for canonical links, share previews, the sitemap and robots.txt.
# Leave empty until the domain is live (a placeholder address is used).
SITE_URL=

# Resend API key (https://resend.com/api-keys). Used to email contact form messages.
RESEND_API_KEY=

# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=

# Sender shown on those emails. Must use a domain verified in Resend.
# Leave empty to use Resend's test sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
